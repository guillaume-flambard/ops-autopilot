# LLM Provider Selection: ollama (local, no quota) | groq (live) | mock (offline, deterministic)
LLM_PROVIDER=mock

# Ollama Configuration (local LLM; leave defaults for a standard install)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Groq Configuration (live LLM; leave GROQ_API_KEY empty to disable the groq option)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Jina Reader (website analysis; optional, lifts the r.jina.ai rate limit)
JINA_API_KEY=your_jina_api_key_here

# App Configuration
APP_SECRET=your_app_secret_here_for_session_and_hashing
# SQLite by default. On an ephemeral host (Streamlit Cloud) point this at a
# managed Postgres for persistent accounts/history, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/ops_autopilot
DATABASE_URL=sqlite:///./ops_autopilot.db
DEFAULT_LOCALE=fr
