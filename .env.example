# Groq Configuration (live LLM; leave GROQ_API_KEY empty for offline mock mode)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# App Configuration
APP_SECRET=your_app_secret_here_for_session_and_hashing
DATABASE_URL=sqlite:///./ops_autopilot.db
DEFAULT_LOCALE=fr

# LLM Provider Selection: mock (offline, deterministic) or groq (live)
LLM_PROVIDER=mock
