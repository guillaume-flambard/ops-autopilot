# Ollama Configuration (primary LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Groq Configuration (fallback LLM)
GROQ_API_KEY=your_groq_api_key_here

# App Configuration
APP_SECRET=your_app_secret_here_for_session_and_hashing
DATABASE_URL=sqlite:///./ops_autopilot.db
DEFAULT_LOCALE=fr

# LLM Provider Selection (ollama or groq)
LLM_PROVIDER=ollama
